APP_NAME=SAFIC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos (dentro de Docker el host es "db", nunca localhost)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=safic
# Usuario de la aplicación: sin BYPASSRLS ni permisos para cambiar estructura
DB_USERNAME=safic_app
DB_PASSWORD=safic_app_local
# Usuario dueño de las tablas: solo migraciones (--database=pgsql_owner)
DB_MIGRATION_USERNAME=safic_owner
DB_MIGRATION_PASSWORD=safic_owner_local
DB_SSLMODE=prefer

# Solo para el contenedor de PostgreSQL (superusuario, no lo usa Laravel)
POSTGRES_PASSWORD=postgres_local

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo local: se ve en http://localhost:8025 (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@safic.ec"
MAIL_FROM_NAME="${APP_NAME}"

# Archivos (S3). Por defecto se usa el MinIO del docker-compose (perfil "minio", consola en http://localhost:9001).
# ¿Ya tienes un S3 en tu Docker? Borra COMPOSE_PROFILES y usa AWS_ENDPOINT=http://host.docker.internal:<puerto>
# con las credenciales y el bucket de tu S3.
COMPOSE_PROFILES=minio
AWS_ACCESS_KEY_ID=safic
AWS_SECRET_ACCESS_KEY=safic_minio_local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=safic-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# JWT: access token RS256 de 15 minutos.
# Local: vacío → se leen storage/jwt/{private,public}.pem (los crea `php artisan safic:jwt-keys`).
# Producción: contenido PEM desde AWS Secrets Manager.
JWT_ALGO=RS256
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_PASSPHRASE=
JWT_TTL=15
JWT_BLACKLIST_ENABLED=true

# Refresh token rotativo (cookie HttpOnly en web, cuerpo en móvil)
SAFIC_REFRESH_TTL_DAYS=30
SAFIC_REFRESH_COOKIE_SECURE=false

# UID/GID de tu usuario en WSL (id -u / id -g) para que los archivos no queden como root
UID=1000
GID=1000
